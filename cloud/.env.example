# 复制为 .env 后填写；.env 已被 .gitignore 排除，密钥永不进仓库
# 一个都不填也能跑：Redis / RDS / MaaS 会自动降级为内存或跳过

# ── 服务端口 ──
PORT=8080

# ── 华为云 MaaS（OpenAI 兼容接口）──
MAAS_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_KEY=
MAAS_MODEL=deepseek-v4.1-flash
MAAS_TIMEOUT=20000

# ── Redis（华为云 DCS），不填则用内存 ──
REDIS_URL=

# ── RDS for MySQL，不填则用内存 ──
RDS_HOST=
RDS_PORT=3306
RDS_USER=root
RDS_PASS=
RDS_DB=yindun

# ── AI 接口限流（按 IP、按北京时间每天清零）──
# 只拦两个花钱的接口：/api/report（截图复审）、/api/drill/turn（演练对练）
# 填 0 表示不限。改了要重启服务才生效。
RATE_REPORT_PER_DAY=60
RATE_DRILL_TURN_PER_DAY=300
# 前面挂了 nginx / 负载均衡才填 1，否则不要填——
# 否则有人伪造 X-Forwarded-For 就能每天换个身份绕过限额
TRUST_PROXY=
