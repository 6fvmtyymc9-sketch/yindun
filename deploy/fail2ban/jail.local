# 银盾 ECS 加固配置 — 2026-11-18
# 背景：2026-11-18 当天 /var/log/auth.log 累计 42,984 次失败登录，
#       来源集中在 109.160.32.0/24 与 77.239.124.143（境外扫描）。
#       当日已同时关闭 SSH 密码认证，本文件是第二层：把扫描源直接封掉。
[DEFAULT]
# 封 1 小时；10 分钟内 5 次失败触发。密码认证关了之后扫描器进不来，
# 这里主要目的是减少 auth.log 噪音、并在答辩时能拿出封禁记录。
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = auto

# 白名单：本机 + 队长与同学常用出门 IP（四川电信 / 移动）
# 关掉密码认证后正常使用不会触发 ban，这里是为了防客户端异常连续重试把自己封了
ignoreip = 127.0.0.1/8 ::1 117.139.198.0/24 171.218.0.0/16 111.9.0.0/16

[sshd]
enabled = true
port    = ssh
