# 复制为 .env 后填写；.env 已被 .gitignore 排除，密钥永不进仓库
# 一个都不填也能跑：Redis / RDS / MaaS 会自动降级为内存或跳过

# ── 服务端口 ──
PORT=8080

# ── 华为云 MaaS（OpenAI 兼容接口）──
MAAS_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_KEY=
MAAS_MODEL=deepseek-v4.1-flash
# 大模型单次请求超时（毫秒）。长录音切成多段后转写稿可能上千字，20 秒不够，
# 2026-11-11 实测 559 字的通话稿会超时。超时不会失败整次复盘，只会退回纯规则判定。
MAAS_TIMEOUT=40000

# ── Redis，不填则用内存 ──
# 本机装的 Redis 或华为云 DCS 托管实例都填这里，代码只认连接串，不区分来源。
# 本项目线上用的是 ECS 本机 redis-server（127.0.0.1），没有购买 DCS 实例。
REDIS_URL=

# ── MySQL，不填则用内存 ──
# 同样只认连接串：本机 mysql-server 或 RDS for MySQL 托管实例都行。
# 线上是 ECS 本机 MySQL 8（127.0.0.1），没有购买 RDS 实例。
RDS_HOST=
RDS_PORT=3306
RDS_USER=root
RDS_PASS=
RDS_DB=yindun

# ── AI 接口限流（按 IP、按北京时间每天清零）──
# 只拦两个花钱的接口：/api/report（截图复审）、/api/drill/turn（演练对练）
# 填 0 表示不限。改了要重启服务才生效。
RATE_REPORT_PER_DAY=60
RATE_DRILL_TURN_PER_DAY=300
# 前面挂了 nginx / 负载均衡才填 1，否则不要填——
# 否则有人伪造 X-Forwarded-For 就能每天换个身份绕过限额
TRUST_PROXY=

# ── 通话录音复盘（/api/callaudio）──
# 设了它，手机端请求头必须带 X-Yd-Token（手机端在 SharedPreferences 的 yd_token 里配）
YD_TOKEN=

# 语音识别二选一；都不填时只能用录音旁边的演示转写稿（结果会标"演示文本"）
# ① 华为云 SIS 一句话识别（≤60 秒）。SIS_TOKEN 和 IAM 账号密码二选一
SIS_REGION=cn-north-4
SIS_PROJECT_ID=
SIS_TOKEN=
HW_IAM_USER=
HW_IAM_PASS=
HW_IAM_DOMAIN=
SIS_PROPERTY=chinese_8k_common
# 接入点，留空即公网 sis-ext.{region}.myhuaweicloud.com。
# **部署在华为云 ECS 上时必须注意**：VPC 内 DNS 会把 sis-ext 解析成 100.125.x.x
# 的 APIG 内网地址，SIS 后端判定为"内网客户端"，返回 SIS.0035 拒绝请求。
# 处置办法见 docs/SIS接入记录.md 的「部署到 ECS」一节。
SIS_ENDPOINT=
# ② 任意 OpenAI 兼容的 /audio/transcriptions 接口
ASR_URL=
ASR_KEY=
ASR_MODEL=whisper-1

# 反诈专用模型 AntiFraud-SFT（第三票，只听音频）
# 留空 = 不启用，链路照常走规则 + 大模型，不报错也不降级
#
# 【2026-11-24 现状：线上已接入】
#   模型跑在学校 GPU 容器上，华为云访问不到校内，所以走 SSH 反向隧道：
#   容器执行 tools/sft_tunnel.sh，把容器本机 8000 映射到 ECS 的 127.0.0.1:8099。
#   于是线上这里填 http://127.0.0.1:8099 —— 对 ECS 来说是本机端口。
#   隧道断了会立刻 ECONNREFUSED（不是干等超时），CallAudio 按"第三票缺席"降级两票。
#
# ⚠️ 不要填成 0.0.0.0 或公网地址：模型服务只该绑 127.0.0.1，隧道只开到回环。
SFT_URL=
# 单条 /judge 的超时（毫秒）。它要生成几百字分析，不是 0.15 秒的 /risk。
SFT_TIMEOUT=120000
# 复盘接口最多等第三票多久（毫秒）。手机端读超时 90 秒，这里别超过 80000。
#
# 实测（2026-11-24，/judge 原生两轮，GPU L40）：
#   demo/calls 三段：4.1s / 4.5s / 29.9s
#   冻结评估集 30 通：中位 8.0s / P90 45.1s / 最长 70.6s
# 取 60000：覆盖两组 P90 有余量；最坏 60 + 大模型约 5 = 65 秒，仍在手机端 90 秒读超时内。
# 那条 70.6 秒的会被放弃，是有意的——为一条长录音把所有复盘拖到 75 秒不划算。
#
# 【历史】2026-11-18 曾经填 8000，那时走的是 /risk（只比第一个 token，114~148ms）。
#   /risk 的 p 与内容几乎无关（静音都得 0.62），11-20 起改用 /judge，8000 会让每通都超时。
SFT_WAIT_MS=60000
