# 复制为 .env 后填写；.env 已被 .gitignore 排除，密钥永不进仓库
# 一个都不填也能跑：Redis / RDS / MaaS 会自动降级为内存或跳过

# ── 服务端口 ──
PORT=8080

# ── 华为云 MaaS（OpenAI 兼容接口）──
MAAS_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_KEY=
MAAS_MODEL=deepseek-v4.1-flash
MAAS_TIMEOUT=20000

# ── Redis（华为云 DCS），不填则用内存 ──
REDIS_URL=

# ── RDS for MySQL，不填则用内存 ──
RDS_HOST=
RDS_PORT=3306
RDS_USER=root
RDS_PASS=
RDS_DB=yindun

# ── AI 接口限流（按 IP、按北京时间每天清零）──
# 只拦两个花钱的接口：/api/report（截图复审）、/api/drill/turn（演练对练）
# 填 0 表示不限。改了要重启服务才生效。
RATE_REPORT_PER_DAY=60
RATE_DRILL_TURN_PER_DAY=300
# 前面挂了 nginx / 负载均衡才填 1，否则不要填——
# 否则有人伪造 X-Forwarded-For 就能每天换个身份绕过限额
TRUST_PROXY=

# ── 通话录音复盘（/api/callaudio）──
# 设了它，手机端请求头必须带 X-Yd-Token（手机端在 SharedPreferences 的 yd_token 里配）
YD_TOKEN=

# 语音识别二选一；都不填时只能用录音旁边的演示转写稿（结果会标"演示文本"）
# ① 华为云 SIS 一句话识别（≤60 秒）。SIS_TOKEN 和 IAM 账号密码二选一
SIS_REGION=cn-north-4
SIS_PROJECT_ID=
SIS_TOKEN=
HW_IAM_USER=
HW_IAM_PASS=
HW_IAM_DOMAIN=
SIS_PROPERTY=chinese_8k_general
# ② 任意 OpenAI 兼容的 /audio/transcriptions 接口
ASR_URL=
ASR_KEY=
ASR_MODEL=whisper-1
