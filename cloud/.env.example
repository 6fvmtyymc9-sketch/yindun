# 复制为 .env 后填写；.env 已被 .gitignore 排除，密钥永不进仓库
# 一个都不填也能跑：Redis / RDS / MaaS 会自动降级为内存或跳过

# ── 服务端口 ──
PORT=8080

# ── 华为云 MaaS（OpenAI 兼容接口）──
MAAS_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_KEY=
MAAS_MODEL=deepseek-v4.1-flash
# 大模型单次请求超时（毫秒）。长录音切成多段后转写稿可能上千字，20 秒不够，
# 2026-11-11 实测 559 字的通话稿会超时。超时不会失败整次复盘，只会退回纯规则判定。
MAAS_TIMEOUT=40000

# ── Redis（华为云 DCS），不填则用内存 ──
REDIS_URL=

# ── RDS for MySQL，不填则用内存 ──
RDS_HOST=
RDS_PORT=3306
RDS_USER=root
RDS_PASS=
RDS_DB=yindun

# ── AI 接口限流（按 IP、按北京时间每天清零）──
# 只拦两个花钱的接口：/api/report（截图复审）、/api/drill/turn（演练对练）
# 填 0 表示不限。改了要重启服务才生效。
RATE_REPORT_PER_DAY=60
RATE_DRILL_TURN_PER_DAY=300
# 前面挂了 nginx / 负载均衡才填 1，否则不要填——
# 否则有人伪造 X-Forwarded-For 就能每天换个身份绕过限额
TRUST_PROXY=

# ── 通话录音复盘（/api/callaudio）──
# 设了它，手机端请求头必须带 X-Yd-Token（手机端在 SharedPreferences 的 yd_token 里配）
YD_TOKEN=

# 语音识别二选一；都不填时只能用录音旁边的演示转写稿（结果会标"演示文本"）
# ① 华为云 SIS 一句话识别（≤60 秒）。SIS_TOKEN 和 IAM 账号密码二选一
SIS_REGION=cn-north-4
SIS_PROJECT_ID=
SIS_TOKEN=
HW_IAM_USER=
HW_IAM_PASS=
HW_IAM_DOMAIN=
SIS_PROPERTY=chinese_8k_common
# 接入点，留空即公网 sis-ext.{region}.myhuaweicloud.com。
# **部署在华为云 ECS 上时必须注意**：VPC 内 DNS 会把 sis-ext 解析成 100.125.x.x
# 的 APIG 内网地址，SIS 后端判定为"内网客户端"，返回 SIS.0035 拒绝请求。
# 处置办法见 docs/SIS接入记录.md 的「部署到 ECS」一节。
SIS_ENDPOINT=
# ② 任意 OpenAI 兼容的 /audio/transcriptions 接口
ASR_URL=
ASR_KEY=
ASR_MODEL=whisper-1

# 反诈专用模型 AntiFraud-SFT（第三票，只听音频）
# 留空 = 不启用，链路照常走规则 + 大模型，不报错也不降级
# 要启用：在**能跑推理的机器**上执行 tools/sft_server.py --port 8099，再把地址填这里。
# 注意：模型 16GB、要 PyTorch，ECS（2 核 2GB 无 GPU）跑不了，别往线上填。
SFT_URL=
# 单条音频判定的超时（毫秒）。CPU 上一次前向 40~80 秒，给少了会误判成失败
SFT_TIMEOUT=120000
# 复盘接口最多等第三票多久（毫秒）。手机端读超时 90 秒，这里别超过 80000
SFT_WAIT_MS=60000
